# Destination the reklamation form POSTs to (JSON body).
# Required. Exposed to the browser (NEXT_PUBLIC_*), so it is inlined at
# BUILD TIME — after changing it you must redeploy / rebuild for the new
# value to take effect.
#
# Copy this file to .env.local for local development.
NEXT_PUBLIC_AUTOMATE_URL=https://example.com/your-endpoint
